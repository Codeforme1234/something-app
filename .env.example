# --- App ---
APP_ENV=dev                      # dev | prod  (prod refuses any fake/outbox mode below)
FRONTEND_ORIGIN=http://localhost:3000

# --- Mode switches (mock <-> real) ---
AUTH_MODE=fake                   # fake | cognito
EMAIL_MODE=outbox                # outbox | ses
LLM_MODE=fake                    # fake | openai

# --- DynamoDB ---
TABLE_NAME=quizdeck-main
AWS_REGION=us-east-1
DYNAMO_ENDPOINT_URL=http://localhost:8001   # set -> DynamoDB Local; unset -> real AWS
# DynamoDB Local accepts any credentials; real AWS uses your normal credential chain
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- Cognito (AUTH_MODE=cognito only) ---
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=us-east-1

# --- SES (EMAIL_MODE=ses only) ---
# SES_FROM_ADDRESS=

# --- OpenAI (LLM_MODE=openai only) ---
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Attempt rules ---
SUBMIT_GRACE_SECONDS=30
