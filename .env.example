# Template for the two real env files, which are gitignored:
#
#   .env.dev    loaded by default
#   .env.prod   loaded only via QUIZDECK_ENV_FILE=.env.prod
#
# app/core/config.py reads QUIZDECK_ENV_FILE and falls back to `.env.dev`, so
# the safe environment is the one you get when you forget to name one.
#
# There is no local DynamoDB, no MinIO and no local-filesystem object store.
# Every environment addresses real AWS and has its OWN table and bucket; the
# test suite reaches neither, because it intercepts boto3 with moto
# (tests/conftest.py). See docs/aws-setup.md.

# --- App ---
APP_ENV=dev                      # dev | prod  (prod refuses every fake mode below)
FRONTEND_ORIGIN=http://localhost:3000

# --- Mode switches (mock <-> real) ---
# Storage is deliberately absent from this list: there is no mock object store.
AUTH_MODE=fake                   # fake | cognito
EMAIL_MODE=outbox                # outbox | ses
LLM_MODE=fake                    # fake | openai

# --- DynamoDB ---
# docs/aws-setup.md#1-dynamodb. NO DEFAULT: an env file that omits this fails at
# startup, rather than silently sharing another environment's table.
TABLE_NAME=quizdeck-dev          # quizdeck-prod in .env.prod
AWS_REGION=ap-south-1
# Local dev only: names a profile in ~/.aws/credentials so the secret lives in
# one place and a read or write cannot land in whatever account your default
# profile points at. Refused when APP_ENV=prod, where credentials come from the
# ECS task role or EC2 instance profile.
# Deliberately not called AWS_PROFILE -- botocore reads that name natively.
DYNAMO_PROFILE=quizdeck

# --- Object storage ---
# docs/aws-setup.md#4-s3. NO DEFAULT, same reasoning as TABLE_NAME.
S3_BUCKET=quizdeck-media-dev     # quizdeck-media in .env.prod
S3_PROFILE=quizdeck              # refused in prod, as above
# OPTIONAL. Unset -> images are proxied through GET /api/v1/images/{key} and the
# bucket stays fully private (no bucket policy at all). Set to a CloudFront
# domain -> served from the edge instead, keeping student traffic off the API.
# Only the object KEY is stored, so switching needs no data migration.
# Knowledge-base documents are never served this way -- they stay behind the
# token-checked /api/v1/knowledge-base route regardless.
# IMAGE_PUBLIC_BASE_URL=https://media.example.com
# How the browser reaches this API -- proxied image URLs are built from it, so
# in a deployment this must be the origin the browser can actually resolve.
API_PUBLIC_ORIGIN=http://localhost:8000
MAX_IMAGE_BYTES=2000000
# Ceiling for the upload routes only; every other route keeps MAX_BODY_BYTES
# in app/main.py.
MAX_UPLOAD_BYTES=20000000

# --- Cognito (AUTH_MODE=cognito only) ---
# docs/aws-setup.md#2-cognito-google-sign-in. ONE pool shared by dev and prod.
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=ap-south-1

# --- SES (EMAIL_MODE=ses only) ---
# docs/aws-setup.md#3-ses. ONE verified domain identity shared by dev and prod.
# Sandbox rules apply until production access is granted.
# SES_FROM_ADDRESS=
# SES_REGION=ap-south-1
# SES_PROFILE=quizdeck           # local dev only; refused in prod
# SUPPORT_EMAIL=

# --- OpenAI (LLM_MODE=openai only) ---
# Not AWS -- just an API key from platform.openai.com.
# OPENAI_API_KEY=
# Neither model has a code default: both are REQUIRED under LLM_MODE=openai, so
# the model you are billed for is always the one named here, and switching model
# is an env change rather than a deploy.
OPENAI_MODEL=gpt-4o-mini
# Also drives the vision pass that transcribes diagram pages.
OPENAI_EXTRACTION_MODEL=gpt-5.6-terra
# Applied to every OpenAI request...
OPENAI_TIMEOUT_SECONDS=60
# ...except extraction, which reads a whole paper in one call.
OPENAI_EXTRACTION_TIMEOUT_SECONDS=600
# The SDK's own retry, separate from the one repair retry on an unusable answer.
OPENAI_MAX_RETRIES=1

# --- Credit economics ---
# Settings rather than constants so pricing changes need no deploy. Creating any
# test spends one STARTING_CREDITS credit; an AI run additionally spends from the
# AI pool (CLAUDE.md rule 8).
STARTING_CREDITS=20
STARTING_AI_CREDITS=20
AI_CREDIT_COST_PROMPT=1
AI_CREDIT_COST_PDF=2

# --- PDF limits ---
MAX_PDF_BYTES=20000000
# Bounds worst-case parse and render cost. A JEE paper is ~25 pages.
MAX_PDF_PAGES=60

# --- Attempt rules ---
SUBMIT_GRACE_SECONDS=30
# Where OutboxEmailSender writes when EMAIL_MODE=outbox.
OUTBOX_DIR=.dev/outbox
