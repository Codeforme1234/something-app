# See docs/aws-setup.md for how to provision everything the "real" side of
# each mode switch below needs, and for the exact real-mode values.

# --- App ---
APP_ENV=dev                      # dev | prod  (prod refuses any fake/outbox mode below)
FRONTEND_ORIGIN=http://localhost:3000

# --- Mode switches (mock <-> real) ---
AUTH_MODE=fake                   # fake | cognito
EMAIL_MODE=outbox                # outbox | ses
LLM_MODE=fake                    # fake | openai

# --- DynamoDB ---
# docs/aws-setup.md#1-dynamodb -- table + IAM policy for real AWS.
TABLE_NAME=quizdeck-main
AWS_REGION=us-east-1
DYNAMO_ENDPOINT_URL=http://localhost:8001   # set -> DynamoDB Local; unset -> real AWS
# DynamoDB Local accepts any credentials; real AWS uses your normal credential chain
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- Cognito (AUTH_MODE=cognito only) ---
# docs/aws-setup.md#2-cognito-google-sign-in -- user pool, Google IdP, app client.
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=us-east-1

# --- SES (EMAIL_MODE=ses only) ---
# docs/aws-setup.md#3-ses -- verify a sender identity first (sandbox mode applies).
# SES_FROM_ADDRESS=

# --- OpenAI (LLM_MODE=openai only) ---
# Not AWS -- just an API key from platform.openai.com. See docs/aws-setup.md#4-flip-the-switches
# for where this fits alongside the AWS switches.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Attempt rules ---
SUBMIT_GRACE_SECONDS=30
