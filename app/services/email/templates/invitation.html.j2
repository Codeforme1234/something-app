{% extends "base.html.j2" %}

{% block preheader %}You've been invited to take {{ test_title }} — due {{ deadline }}{% endblock %}

{% block content %}
<p style="margin:0 0 16px 0; font-size:16px; line-height:24px;">Hi {{ student_name }},</p>
<p style="margin:0 0 24px 0; font-size:16px; line-height:24px;">
  You're invited to take <strong>{{ test_title }}</strong>.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f7f2fa; border-radius:8px; margin:0 0 24px 0;">
  <tr>
    <td style="padding:16px 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:4px 0; font-size:14px; color:#49454f;">Deadline</td>
          <td align="right" style="padding:4px 0; font-size:14px; font-weight:700; color:#1c1b1f;">{{ deadline }}</td>
        </tr>
        <tr>
          <td style="padding:4px 0; font-size:14px; color:#49454f;">Duration</td>
          <td align="right" style="padding:4px 0; font-size:14px; font-weight:700; color:#1c1b1f;">{{ duration }}</td>
        </tr>
        <tr>
          <td style="padding:4px 0; font-size:14px; color:#49454f;">Questions</td>
          <td align="right" style="padding:4px 0; font-size:14px; font-weight:700; color:#1c1b1f;">{{ questions }}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 0;">
  <tr>
    <td align="center" bgcolor="#6750a4" style="border-radius:24px;">
      <a
        href="{{ link }}"
        target="_blank"
        style="display:inline-block; padding:12px 28px; font-size:16px; font-weight:700; color:#ffffff; text-decoration:none; border-radius:24px; font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;"
        >Start your test</a
      >
    </td>
  </tr>
</table>

<p style="margin:0 0 4px 0; font-size:13px; color:#79747e;">Or copy this link into your browser:</p>
<p style="margin:0; font-size:13px; color:#6750a4; word-break:break-all;">{{ link }}</p>
{% endblock %}

{% block footer %}You received this email because your teacher invited you to a test on QuizDeck.{% endblock %}
